<script>
  // Hero loop loader. Deliberately after load: the video must never compete with
  // LCP on a site whose whole value is organic ranking.
  (function () {
    var v = document.getElementById('hero-loop');
    if (!v) return;
    var still = document.getElementById('hero-still');
    var conn = navigator.connection || {};
    var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Skip on phones (saves 687KB on the connections least able to spare it),
    // when the visitor asked for less motion, or on metered/save-data connections.
    // Only skip on width when we actually know it: a hidden or prerendering tab
    // reports 0, and that must not be mistaken for a small screen.
    var w = window.innerWidth || document.documentElement.clientWidth || 0;
    if (reduced || (w > 0 && w < 768) || conn.saveData) return;

    function reveal() {
      v.style.opacity = '1';
      if (still) still.style.opacity = '0';
      var scrim = document.getElementById('hero-scrim');
      if (scrim) scrim.style.opacity = '0.12';
      var wash = document.getElementById('hero-wash');
      if (wash) wash.style.opacity = '1';
    }

    function tryPlay() {
      var p = v.play();
      if (!p || !p.catch) return;
      p.catch(function () {
        // Autoplay is refused while the tab is in the background. Don't give up
        // permanently - a link opened in a new tab is a normal way to arrive here.
        document.addEventListener('visibilitychange', function again() {
          if (document.visibilityState !== 'visible') return;
          document.removeEventListener('visibilitychange', again);
          v.play().catch(function () { /* still refused - the poster stands in */ });
        });
      });
    }

    function start() {
      var done = false;
      var timer;
      function go() {
        if (done || v.paused || !v.currentTime) return;
        done = true;
        clearInterval(timer);
        v.removeEventListener('playing', go);
        v.removeEventListener('timeupdate', go);
        reveal();
      }
      v.addEventListener('playing', go);
      v.addEventListener('timeupdate', go);
      timer = setInterval(go, 400);
      v.src = '/videos/hero-loop.mp4';
      tryPlay();
    }

    if (document.readyState === 'complete') start();
    else window.addEventListener('load', start);
  })();
</script>
